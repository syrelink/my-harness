DEEPSEEK_API_KEY=your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 原生多模态主模型。图片作为当前 HumanMessage 的 image_url 内容块传入。
GAME_ASSISTANT_MODEL=mimo-v2.5
GAME_ASSISTANT_BASE_URL=https://api.xiaomimimo.com/v1
GAME_ASSISTANT_API_KEY=your-mimo-api-key

DATABASE_URL=postgresql://gamescope:gamescope@127.0.0.1:5433/gamescope?sslmode=disable
# MinIO S3 API（不是 9001 Console 端口）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=game-rover-attachments
MINIO_SECURE=false
# 应用主动使用的有效上下文窗口，不等同于模型API的物理上限。
GAME_EFFECTIVE_CONTEXT_TOKENS=65536
GAME_CONTEXT_TRIGGER_RATIO=0.8
GAME_CONTEXT_RETAIN_RATIO=0.16
GAME_SUMMARY_BUDGET_TOKENS=8192
GAME_TOOL_RESULT_BUDGET_TOKENS=2500
GAME_PROMPT_OVERHEAD_TOKENS=2500
GAME_SUMMARY_TIMEOUT_SECONDS=12
GAME_TOOL_TIMEOUT_SECONDS=35

# Langfuse 可观测性（可选；不配置则降级为 no-op）
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
